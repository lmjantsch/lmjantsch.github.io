---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = Extract<CollectionEntry<'news'>['data'], { kind: 'writeup' }>;

const { title, summary, date, updatedDate } = Astro.props;
---

<BaseLayout title={title} description={summary ?? title}>
	<main class="mx-auto max-w-6xl px-4 py-8">
		<article class="prose prose-lg mx-auto dark:prose-invert">
			<div class="mb-8 text-center">
				<p class="text-base text-secondary dark:text-secondary_dark">
					<FormattedDate date={date} />
				</p>
				<h1 class="mb-2 text-4xl font-bold text-primary dark:text-primary_dark">{title}</h1>
				{updatedDate && (
					<p class="text-sm italic text-secondary dark:text-secondary_dark">
						Last updated on <FormattedDate date={updatedDate} />
					</p>
				)}
			</div>

			<slot />
		</article>
		<p class="mx-auto mt-10 max-w-prose text-sm">
			<a href="/" class="text-secondary hover:underline dark:text-secondary_dark">← Back to news</a>
		</p>
	</main>
	<Footer />
</BaseLayout>
