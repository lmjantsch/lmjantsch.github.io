      "items": [
        {
          "title": "Where Does the Noise Come From? Rectified Edge Attribution Patching for Accurate Circuit Discovery",
          "authors": [
            "Lasse Jantsch",
            "Dong-Jae Koh",
            "Huisu Kim",
            "Seonghyeon Lee",
            "Young-Kyoon Suh"
          ],
          "venue": "Under Review",
          "year": 2026,
          "status": "under-review",
          "featured": true,
          "summary": "Edge Attribution Patching is the standard fast method for finding circuits in a model, but its gradient approximation quietly introduces error. We trace where that error comes from and correct it.",
          "bullets": [
            "Identified three sources of approximation noise in Edge Attribution Patching (EAP) and introduced lightweight backward-pass corrections in LayerNorms, bilinear functions and MLP activations.",
            "Corrections consistently improve the faithfulness and robustness of discovered circuits across multiple LLM families with minimal increase of compute."
          ],
          "links": []
        },
        {
          "title": "Dual Path Attribution: Efficient Attribution for SwiGLU-Transformers through Layer-Wise Target Propagation",
          "authors": [
            "Lasse Jantsch",
            "Dong-Jae Koh",
            "Seonghyeon Lee",
            "Young-Kyoon Suh"
          ],
          "venue": "EMNLP 2026; Mechanistic Interpretability Workshop @ ICML 2026",
          "year": 2026,
          "status": "accepted",
          "featured": true,
          "summary": "Attributing model behaviour to individual components normally costs one pass per component. Dual Path Attribution gets dense attributions for the whole network in a single forward and backward pass.",
          "bullets": [
            "Developed Dual Path Attribution (DPA), a decomposition-based framework that traces information flow on the frozen transformer in one forward and one backward pass.",
            "Achieved $O(1)$ time complexity with respect to the number of model components, enabling highly efficient dense component attribution while establishing state-of-the-art faithfulness."
          ],
          "links": []
        },
        {
          "title": "FineCite: A Novel Approach For Fine-Grained Citation Context Analysis",
          "authors": [
            "Lasse M. Jantsch",
            "Dong-Jae Koh",
            "Seonghwan Yoon",
            "Jisu Lee",
            "Anne Lauscher",
            "Young-Kyoon Suh"
          ],
          "venue": "Findings of the Association for Computational Linguistics: ACL 2025",
          "year": 2025,
          "status": "published",
          "featured": true,
          "summary": "Citation contexts are usually reduced to a single sentence. FineCite defines and annotates what the citing text actually claims about a source, at the span level.",
          "bullets": [],
          "links": [
            {
              "label": "Paper",
