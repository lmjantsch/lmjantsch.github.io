---
import { formatRange, startValue } from '../../lib/cv.mjs';

interface Props {
	items: any[];
	display?: 'featured' | 'default' | 'compact';
}

const { items, display = 'default' } = Astro.props;
const sorted = [...items].sort((a, b) => startValue(b) - startValue(a));
const compact = display === 'compact';
---
<ol class={compact ? 'space-y-3' : 'space-y-5'}>
	{sorted.map((item) => (
		<li class="flex flex-col gap-x-4 sm:flex-row sm:items-baseline">
			<p class="shrink-0 text-xs text-secondary dark:text-secondary_dark sm:w-36 sm:pt-1">
				{formatRange(item.start, item.end)}
			</p>
			<div class="min-w-0">
				<p class="text-primary dark:text-primary_dark">
					<strong class={compact ? 'text-sm' : 'text-base'}>{item.role}</strong>
					<span class="text-secondary dark:text-secondary_dark text-sm"> — {item.org}</span>
				</p>
				<p class="text-xs text-secondary dark:text-secondary_dark">
					{[item.unit, item.location].filter(Boolean).join(' · ')}
				</p>
				{item.supervisor && (
					<p class="text-xs italic text-secondary dark:text-secondary_dark">Supervisor: {item.supervisor}</p>
				)}
				{item.topics?.length > 0 && (
					<ul class="mt-1.5 flex flex-wrap gap-1.5">
						{item.topics.map((topic: string) => (
							<li class="rounded-full bg-secondary_bg dark:bg-secondary_bg_dark px-2 py-0.5 text-[11px] text-secondary dark:text-secondary_dark">
								{topic}
							</li>
						))}
					</ul>
				)}
				{item.bullets?.length > 0 && (
					<ul class="mt-1.5 list-disc space-y-0.5 pl-5 text-sm text-secondary dark:text-secondary_dark">
						{item.bullets.map((bullet: string) => <li>{bullet}</li>)}
					</ul>
				)}
				{item.links?.length > 0 && (
					<div class="mt-1 flex flex-wrap gap-3 text-sm">
						{item.links.map((link: any) => (
							<a href={link.url} class="text-primary dark:text-primary_dark hover:underline">
								{link.icon} {link.label}
							</a>
						))}
					</div>
				)}
			</div>
		</li>
	))}
</ol>
