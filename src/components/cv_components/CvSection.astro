---
interface Props {
	title: string;
	icon?: string;
	note?: string;
	display?: 'featured' | 'default' | 'compact';
	id?: string;
}

const { title, icon, note, display = 'default', id } = Astro.props;

const headingSize = display === 'compact' ? 'text-xl' : 'text-2xl';
const spacing = display === 'compact' ? 'mb-7' : 'mb-10';
---
<section id={id} class={spacing}>
	<h2 class={`${headingSize} font-semibold text-primary dark:text-primary_dark scroll-mt-20`}>
		{icon && <span class="mr-1.5" aria-hidden="true">{icon}</span>}{title}
	</h2>
	{note && <p class="mt-1 text-xs text-secondary dark:text-secondary_dark">{note}</p>}
	<div class="mt-4">
		<slot />
	</div>
</section>
