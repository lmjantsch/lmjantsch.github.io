---
import { splitAuthors, stripMath, PUBLICATION_STATUS } from '../../lib/cv.mjs';
import { AUTHOR_NAME } from '../../data/consts';

const { items } = Astro.props;

const featured = items.filter((item: any) => item.featured);
const rest = items.filter((item: any) => !item.featured);
---
<div class="space-y-5">
	{featured.map((item: any) => (
		<article class="rounded-xl bg-secondary_bg dark:bg-secondary_bg_dark p-4 sm:p-5">
			<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
				<span class="text-xs font-semibold text-secondary dark:text-secondary_dark">{item.year}</span>
				{PUBLICATION_STATUS[item.status] && (
					<span class="rounded-full border border-secondary/40 dark:border-secondary_dark/40 px-2 py-0.5 text-[11px] text-secondary dark:text-secondary_dark">
						{PUBLICATION_STATUS[item.status]}
					</span>
				)}
				{item.award && <span class="text-[11px] text-green-600 dark:text-green-400">{item.award}</span>}
			</div>

			<h3 class="mt-1.5 font-semibold text-primary dark:text-primary_dark">{item.title}</h3>

			<p class="mt-1 text-sm italic text-secondary dark:text-secondary_dark">
				{splitAuthors(item.authors, AUTHOR_NAME).map((author: any, i: number) => (
					<>
						{i > 0 && ', '}
						{author.isOwner ? <strong class="not-italic text-primary dark:text-primary_dark">{author.name}</strong> : author.name}
					</>
				))}
			</p>
			<p class="text-xs text-secondary dark:text-secondary_dark">{item.venue}</p>

			{item.summary && (
				<p class="mt-2.5 text-sm text-primary dark:text-primary_dark">{stripMath(item.summary)}</p>
			)}

			{item.bullets?.length > 0 && (
				<ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-secondary dark:text-secondary_dark">
					{item.bullets.map((bullet: string) => <li>{stripMath(bullet)}</li>)}
				</ul>
			)}

			{item.links?.length > 0 && (
				<div class="mt-3 flex flex-wrap gap-3 text-sm">
					{item.links.map((link: any) => (
						<a href={link.url} class="text-primary dark:text-primary_dark hover:underline">
							{link.icon} {link.label}
						</a>
					))}
				</div>
			)}
		</article>
	))}

	{rest.length > 0 && (
		<details class="group rounded-xl border border-secondary_bg dark:border-secondary_bg_dark px-4 py-3">
			<summary class="cursor-pointer list-none text-sm text-secondary dark:text-secondary_dark hover:text-primary dark:hover:text-primary_dark">
				<span class="inline-block transition-transform group-open:rotate-90" aria-hidden="true">▸</span>
				<span class="ml-1">{rest.length} further publications</span>
			</summary>
			<ul class="mt-3 space-y-3">
				{rest.map((item: any) => (
					<li class="text-sm">
						<span class="text-primary dark:text-primary_dark">{item.title}</span>
						{item.award && <span class="ml-1 text-[11px] text-green-600 dark:text-green-400">{item.award}</span>}
						<span class="block text-xs italic text-secondary dark:text-secondary_dark">
							{item.venue}, {item.year}
						</span>
						{item.links?.length > 0 && (
							<span class="flex flex-wrap gap-3 pt-0.5">
								{item.links.map((link: any) => (
									<a href={link.url} class="text-xs text-primary dark:text-primary_dark hover:underline">
										{link.icon} {link.label}
									</a>
								))}
							</span>
						)}
					</li>
				))}
			</ul>
		</details>
	)}
</div>
