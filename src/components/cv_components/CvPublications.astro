---
import NewsTimeline from '../news_components/NewsTimeline.astro';
import { parseDate } from '../../lib/cv.mjs';
import { newsEntryFor } from '../../lib/cv-content.mjs';

interface Props {
	items: any[];
}

// Already newest first (see readCv). Each renders with the news feed's own
// NewsItem: linked to the paper when there is one, an inert note otherwise.
const { items } = Astro.props;
const entries = items.map((item) => ({
	year: parseDate(item.date).year,
	entry: { data: newsEntryFor(item, 'publications') },
}));
---
<NewsTimeline entries={entries} initial={5} step={10} noun="publication" />
