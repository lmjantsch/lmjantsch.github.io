---
const { items } = Astro.props;
---
<dl class="space-y-2">
	{items.map((group: any) => (
		<div class="flex flex-col gap-x-3 sm:flex-row">
			<dt class="shrink-0 text-sm font-semibold text-primary dark:text-primary_dark sm:w-40">{group.category}</dt>
			<dd class="text-sm text-secondary dark:text-secondary_dark">
				{group.tools.map((tool: any, i: number) => (
					<>
						{i > 0 && ', '}
						<span class={tool.active ? 'text-primary dark:text-primary_dark' : undefined}>
							{tool.name}{tool.active && <span aria-label="currently in use" title="Currently in use">*</span>}
						</span>
					</>
				))}
			</dd>
		</div>
	))}
</dl>
