---
import { ArrowUpRight, ArrowRight } from '@lucide/astro';
import FormattedDate from '../FormattedDate.astro';
import { splitAuthors, AUTHOR_NAME } from '../../lib/cv.mjs';

interface Props {
	entry: any;
}

const { entry } = Astro.props;
// `date` is optional so the CV's publication timeline, which shows the year
// itself, can reuse this component. `authors`, `venue` and `links` only come from CV items.
const { kind, title, summary, featured, tags = [], date, authors, venue, links = [] } = entry.data;

// Author list with the site owner's name emphasised.
const authorParts = authors ? splitAuthors(authors, AUTHOR_NAME) : [];

// Where the item sends the reader — a note sends them nowhere, and must not
// look clickable.
const href = kind === 'external' ? entry.data.url : kind === 'writeup' ? `/news/${entry.id}` : null;
const isLink = href !== null;

// Label for the destination affordance.
const destination =
	kind === 'external' ? entry.data.source : kind === 'writeup' ? 'Read on this site' : null;

const linkProps = kind === 'external' ? { target: '_blank', rel: 'noopener noreferrer' } : {};

// The whole item is clickable through the title link's ::after, which covers the
// item. A real wrapping <a> can't be used, because further links sit inside it.
const stretched = 'after:absolute after:inset-0 after:content-[""] focus-visible:outline-none';

const hasFooter = tags.length > 0 || links.length > 0;
---
{featured ? (
	<article
		class={`relative rounded-xl bg-secondary_bg p-5 dark:bg-secondary_bg_dark ${
			isLink
				? 'transition-transform duration-300 hover:scale-[1.02] has-[a:focus-visible]:outline has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2'
				: 'cursor-default'
		}`}
	>
		<div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-secondary dark:text-secondary_dark">
			{date && <FormattedDate date={date} />}
			{destination && (
				<>
					{date && <span aria-hidden="true">·</span>}
					<span class="inline-flex items-center gap-1 font-medium">
						{destination}
						{kind === 'external' ? <ArrowUpRight class="h-3.5 w-3.5" /> : <ArrowRight class="h-3.5 w-3.5" />}
					</span>
				</>
			)}
		</div>

		<h2 class="mt-2 text-xl font-bold text-primary dark:text-primary_dark">
			{isLink ? <a href={href} {...linkProps} class={`no-underline ${stretched}`}>{title}</a> : title}
		</h2>
		{authorParts.length > 0 && (
			<p class="mt-1 text-sm italic text-secondary dark:text-secondary_dark">
				{authorParts.map((author, i) => (
					<>{i > 0 && ', '}{author.isOwner ? <strong class="not-italic text-primary dark:text-primary_dark">{author.name}</strong> : author.name}</>
				))}
			</p>
		)}
		{venue && <p class="mt-0.5 text-xs text-secondary dark:text-secondary_dark">{venue}</p>}
		{summary && <p class="mt-1.5 text-sm text-secondary dark:text-secondary_dark">{summary}</p>}

		{hasFooter && (
			<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
				{tags.length > 0 && (
					<ul class="flex flex-wrap gap-1.5">
						{tags.map((tag: string) => (
							<li class="rounded-full border border-secondary/30 px-2 py-0.5 text-[11px] text-secondary dark:border-secondary_dark/30 dark:text-secondary_dark">
								{tag}
							</li>
						))}
					</ul>
				)}
				{links.length > 0 && (
					<ul class="relative z-10 ml-auto flex flex-wrap gap-3">
						{links.map((link: any) => (
							<li>
								<a href={link.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-medium text-primary hover:underline dark:text-primary_dark">
									{link.label}
									<ArrowUpRight class="h-3 w-3" />
								</a>
							</li>
						))}
					</ul>
				)}
			</div>
		)}
	</article>
) : (
	<article
		class={`relative flex flex-col gap-x-4 rounded-lg px-3 py-2 sm:flex-row sm:items-baseline ${
			isLink
				? 'transition-colors hover:bg-secondary_bg dark:hover:bg-secondary_bg_dark has-[a:focus-visible]:outline has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2'
				: 'cursor-default'
		}`}
	>
		{date && (
			<p class="shrink-0 text-xs text-secondary dark:text-secondary_dark sm:w-28 sm:pt-0.5">
				<FormattedDate date={date} />
			</p>
		)}
		<div class="min-w-0 flex-1">
			<p class="text-sm text-primary dark:text-primary_dark">
				{isLink ? <a href={href} {...linkProps} class={`no-underline ${stretched}`}>{title}</a> : title}
				{destination && (
					<span class="ml-1.5 inline-flex items-center gap-1 whitespace-nowrap text-xs text-secondary dark:text-secondary_dark">
						{destination}
						{kind === 'external' ? <ArrowUpRight class="h-3 w-3" /> : <ArrowRight class="h-3 w-3" />}
					</span>
				)}
			</p>
			{authorParts.length > 0 && (
				<p class="text-xs italic text-secondary dark:text-secondary_dark">
					{authorParts.map((author, i) => (
						<>{i > 0 && ', '}{author.isOwner ? <strong class="not-italic text-primary dark:text-primary_dark">{author.name}</strong> : author.name}</>
					))}
				</p>
			)}
			{venue && <p class="text-xs text-secondary dark:text-secondary_dark">{venue}</p>}
			{summary && <p class="text-xs text-secondary dark:text-secondary_dark">{summary}</p>}

			{hasFooter && (
				<div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1.5">
					{tags.length > 0 && (
						<ul class="flex flex-wrap gap-1.5">
							{tags.map((tag: string) => (
								<li class="rounded-full border border-secondary/30 px-2 py-0.5 text-[11px] text-secondary dark:border-secondary_dark/30 dark:text-secondary_dark">
									{tag}
								</li>
							))}
						</ul>
					)}
					{links.length > 0 && (
						<ul class="relative z-10 ml-auto flex flex-wrap gap-3">
							{links.map((link: any) => (
								<li>
									<a href={link.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-medium text-primary hover:underline dark:text-primary_dark">
										{link.label}
										<ArrowUpRight class="h-3 w-3" />
									</a>
								</li>
							))}
						</ul>
					)}
				</div>
			)}
		</div>
	</article>
)}
