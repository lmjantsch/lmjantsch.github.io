---
import { GREETING, INTRODUCTION, CV_PDF_PATH } from '../data/consts';
import { getCollection } from 'astro:content';
import { forTarget } from '../lib/cv-content.mjs';
import profilePicture from '../assets/profile_picture.jpg';
import { FileText } from '@lucide/astro';
import Footer from '../components/Footer.astro';
import Socials from '../components/Socials.astro';
import CvSection from '../components/cv_components/CvSection.astro';
import CvPublications from '../components/cv_components/CvPublications.astro';
import CvExperience from '../components/cv_components/CvExperience.astro';
import CvEducation from '../components/cv_components/CvEducation.astro';
import CvSkills from '../components/cv_components/CvSkills.astro';
import CvCompactList from '../components/cv_components/CvCompactList.astro';

const sections = forTarget((await getCollection('cv')).map((entry) => entry.data), 'web');
---
<div>
	<section class="mx-auto flex min-h-[90vh] max-w-3xl flex-col px-4 py-8">

		<!-- Intro -->
		<div class="flex flex-col items-center text-center">
			<img
				src={profilePicture.src}
				alt={`Profile picture of ${GREETING.replace(/^[^A-Za-z]*/, '')}`}
				class="mb-6 h-60 w-60 rounded-full object-cover shadow-lg"
			/>

			<h1 class="mb-4 text-4xl font-bold text-primary dark:text-primary_dark">{GREETING}</h1>

			<p class="mb-2 max-w-xl text-lg text-secondary dark:text-secondary_dark">{INTRODUCTION}</p>

			<div class="mt-2">
				<Socials />
			</div>

			<a
				href={CV_PDF_PATH}
				class="mt-4 inline-flex items-center gap-2 rounded-full bg-secondary_bg px-4 py-2 text-sm text-primary transition-transform hover:scale-[1.03] dark:bg-secondary_bg_dark dark:text-primary_dark"
			>
				<FileText class="h-4 w-4" />
				Download CV (PDF)
			</a>
		</div>

		<!-- CV, ordered by importance (each section's `order` in src/cv/*/_section.mdx) -->
		<div class="mt-12 w-full text-left">
			{sections.map((section: any) => (
				<CvSection id={section.id} title={section.title} icon={section.icon} note={section.note} display={section.display}>
					{section.kind === 'publications' ? (
						<CvPublications items={section.items} />
					) : section.kind === 'experience' ? (
						<CvExperience items={section.items} display={section.display} />
					) : section.kind === 'education' ? (
						<CvEducation items={section.items} />
					) : section.kind === 'skills' ? (
						<CvSkills items={section.items} />
					) : (
						<CvCompactList items={section.items} kind={section.kind} />
					)}
				</CvSection>
			))}
		</div>

		<Footer />
	</section>
</div>
